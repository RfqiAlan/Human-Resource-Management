<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.KaryawanController"
            stylesheets="@/style/style.css"
            styleClass="bg-gradient-karyawan">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-karyawan">
            <Label text="Employee Dashboard"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox spacing="30" alignment="TOP_CENTER" style="-fx-padding: 30px;">
            <!-- KIRI: Panel Pengajuan Cuti -->
            <VBox spacing="25" HBox.hgrow="ALWAYS" style="-fx-pref-width: 100%;">
                <!-- Cuti Card -->
                <VBox spacing="20" styleClass="card" style="-fx-padding: 30px;">
                    <Label text="Leave Request" styleClass="card-title, card-title-green" />
                    
                    <VBox spacing="8">
                        <Label text="Reason for leave" style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" />
                        <TextArea fx:id="fieldCuti" promptText="Enter your reason here..."
                                  wrapText="true"
                                  styleClass="text-area"
                                  style="-fx-pref-height: 120px;" />
                    </VBox>
                    
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Button fx:id="btnAjukanCuti" text="Submit Request"
                                onAction="#handleAjukanCuti"
                                styleClass="btn, btn-success" />
                        <Button text="Check Status"
                                onAction="#handleLihatCuti"
                                styleClass="btn, btn-info" />
                    </HBox>
                    
                    <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                        <Label text="Status update" style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" />
                        <TextArea fx:id="areaCutiStatus"
                                  promptText="Leave request status will appear here"
                                  editable="false"
                                  wrapText="true"
                                  styleClass="text-area"
                                  style="-fx-pref-height: 80px; -fx-background-color: #f1f5f9;" />
                    </VBox>
                </VBox>
            </VBox>

            <!-- KANAN: Panel Gaji & Absensi -->
            <VBox spacing="25" HBox.hgrow="ALWAYS" style="-fx-pref-width: 100%;">
                <VBox spacing="20" styleClass="card" style="-fx-padding: 30px;">
                    <Label text="Attendance &amp; Payroll" styleClass="card-title, card-title-green" />

                    <!-- Panel Absensi -->
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 15px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <Button fx:id="btnAbsensi" text="Clock In"
                                onAction="#handleAbsensi"
                                styleClass="btn, btn-primary" style="-fx-pref-width: 120px;" />
                        <Label fx:id="labelStatus" text="Not clocked in"
                               style="-fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: bold;" />
                    </HBox>

                    <!-- Panel Gaji -->
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f0fdf4; -fx-padding: 15px; -fx-background-radius: 8px; -fx-border-color: #bbf7d0; -fx-border-radius: 8px;">
                        <Button fx:id="btnLihatGaji" text="View Salary"
                                onAction="#handleLihatGaji"
                                styleClass="btn, btn-success" style="-fx-pref-width: 120px;" />
                        <Label fx:id="labelGaji" text="Rp 0"
                               style="-fx-font-size: 16px; -fx-text-fill: #166534; -fx-font-weight: bold;" />
                    </HBox>

                    <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                        <Label text="Recent Attendance" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <TableView fx:id="tableRiwayatAbsensi" styleClass="table-view" style="-fx-pref-height: 200px;">
                            <columns>
                                <TableColumn fx:id="colTanggal" text="Date" prefWidth="120"/>
                                <TableColumn fx:id="colJam" text="Time" prefWidth="100"/>
                                <TableColumn fx:id="colKeterangan" text="Status" prefWidth="130"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="footer-dark" style="-fx-padding: 10px 20px;">
            <StackPane fx:id="marqueePane" style="-fx-background-color: #334155; -fx-background-radius: 6px; -fx-padding: 8px 15px;" HBox.hgrow="ALWAYS">
                <Label fx:id="marqueeLabel" text="Welcome to Employee Dashboard! Please remember to clock in and out daily."
                       style="-fx-font-size: 14px; -fx-text-fill: #f8fafc;" />
            </StackPane>
            <Button text="Logout" onAction="#handleLogout"
                    styleClass="btn, btn-danger" />
        </HBox>
    </bottom>
</BorderPane>